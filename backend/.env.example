DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/pos_system
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=https://pos-systwm.vercel.app,http://localhost:5173
# Optional. Leave unset to run without caching. Use the provider's private URL in production.
REDIS_URL=
REDIS_SOCKET_TIMEOUT_SECONDS=0.4
REDIS_CONNECT_TIMEOUT_SECONDS=0.4
REDIS_MAX_CONNECTIONS=20
DASHBOARD_CACHE_TTL_SECONDS=30
REPORTS_CACHE_TTL_SECONDS=60
CATALOG_CACHE_TTL_SECONDS=60
SETTINGS_CACHE_TTL_SECONDS=600
